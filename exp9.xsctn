package require csdl

set _title ""
set ::Stackup::couplingLength "0.0"
set ::Stackup::riseTime "0.0"
set ::Stackup::frequency "1e9"
set ::Stackup::defaultLengthUnits "meters"
set CSEG 10
set DSEG 10

GroundPlane GrouPlan1  \
	 -thickness 1.0 \
	 -yOffset 0.0 \
	 -xOffset 0.0
DielectricLayer DielLaye1  \
	 -thickness 10 \
	 -lossTangent 0.0016 \
	 -permittivity 3.02 \
	 -permeability 1.0 \
	 -yOffset 0.0 \
	 -xOffset 0.0
RectangleConductors RectCond1  \
	 -width 18 \
	 -pitch 50 \
	 -conductivity 3.0e7S/m \
	 -height 1.4 \
	 -number 2 \
	 -yOffset 0.0 \
	 -xOffset 0.0
